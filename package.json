{
  "name": "tabbrew-cli",
  "version": "0.1.0",
  "description": "TabBrew CLI",
  "type": "module",
  "license": "MIT",
  "author": "Jiho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colevels/tabbrew-cli.git"
  },
  "bin": {
    "tabbrew": "src/index.ts"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/tabbrew",
    "build:ext": "wxt build extension",
    "dev:ext": "wxt extension",
    "zip:ext": "wxt zip extension",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension",
    "test": "bun test",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "postinstall": "wxt prepare extension"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "wxt": "0.21.4"
  }
}
