{
  "name": "tabbrew-cli",
  "version": "0.9.4",
  "description": "Manage Chrome tabs, windows and tab groups from the terminal, for people and AI coding agents",
  "type": "module",
  "license": "MIT",
  "author": "Jiho",
  "homepage": "https://github.com/colevels/tabbrew-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colevels/tabbrew-cli.git"
  },
  "bugs": {
    "url": "https://github.com/colevels/tabbrew-cli/issues"
  },
  "keywords": [
    "tabbrew",
    "cli",
    "chrome",
    "tabs",
    "tab-groups",
    "chrome-extension",
    "bun",
    "ai-agents",
    "claude-code"
  ],
  "bin": {
    "tabbrew": "src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/e2e"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/tabbrew",
    "build:ext": "wxt build extension",
    "dev:ext": "wxt extension",
    "zip:ext": "wxt zip extension",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension",
    "test": "bun test",
    "test:e2e": "TABBREW_E2E=1 bun test --timeout 60000 src/e2e",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "wxt prepare extension"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "wxt": "0.21.4"
  }
}
